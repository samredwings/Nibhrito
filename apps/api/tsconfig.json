{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../..",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@nibhrito/contracts": [
        "../../packages/contracts/src"
      ],
      "@nibhrito/context-engine": [
        "../../packages/context-engine/src"
      ],
      "@nibhrito/ai-providers": [
        "../../packages/ai-providers/src"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
