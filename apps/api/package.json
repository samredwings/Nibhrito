{
  "name": "@nibhrito/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate --schema=prisma/schema.prisma && tsx watch src/index.ts",
    "build": "prisma generate --schema=prisma/schema.prisma && tsc",
    "start": "prisma generate --schema=prisma/schema.prisma && node dist/apps/api/src/index.js",
    "test": "prisma generate --schema=prisma/schema.prisma && vitest run",
    "test:watch": "prisma generate --schema=prisma/schema.prisma && vitest",
    "typecheck": "prisma generate --schema=prisma/schema.prisma && tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nibhrito/contracts": "workspace:*",
    "@nibhrito/context-engine": "workspace:*",
    "@nibhrito/ai-providers": "workspace:*",
    "@prisma/client": "^5.10.0",
    "express": "^4.18.3",
    "cors": "^2.8.5",
    "zod": "^3.22.4",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.11.0",
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2",
    "eslint": "^8.57.0"
  }
}
