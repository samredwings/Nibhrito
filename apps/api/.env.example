# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nibhrito?schema=public"

# API server
PORT=3001
NODE_ENV=development
APP_NAME=Nibhrito
APP_VERSION=0.2.0

# Local single-owner authentication
# In production, configure a 6-12 digit PIN on the API host:
# NIBHRITO_LOCAL_PIN=123456 pnpm --filter @nibhrito/api auth:set-pin
# The PIN is stored as a salted scrypt hash in LocalProfile, never as plaintext.

# AI provider selection: ollama | huggingface | openrouter | fake
# Production does not silently fall back to the fake provider.
AI_PROVIDER=ollama

# Ollama (local-first)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Hugging Face (optional)
# AI_PROVIDER=huggingface
# HUGGINGFACE_API_KEY=your_key_here
# HUGGINGFACE_MODEL=your-model-id
# HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# OpenRouter (optional)
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_key_here
# OPENROUTER_MODEL=your-model-id
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=Nibhrito
